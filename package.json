{
  "name": "portofolio-nahzul",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/style.css -o ./public/css/output.css --minify",
    "watch:css": "tailwindcss -i ./src/style.css -o ./public/css/output.css --watch",
    "start": "node server.js",
    "dev": "npm run build:css && node server.js"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.10"
  }
}
